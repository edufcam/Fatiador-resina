name: Gerar instalador

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  instalador:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Ler a versão
        id: versao
        shell: pwsh
        run: |
          $v = (Select-String -Path fatiador/__init__.py -Pattern 'VERSAO\s*=\s*"([^"]+)"').Matches[0].Groups[1].Value
          "numero=$v" >> $env:GITHUB_OUTPUT

      - name: Ver se esta versão já foi publicada
        id: existe
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release view "v${{ steps.versao.outputs.numero }}" *> $null
          if ($LASTEXITCODE -eq 0) { "pular=sim" >> $env:GITHUB_OUTPUT } else { "pular=nao" >> $env:GITHUB_OUTPUT }
          exit 0

      - uses: actions/setup-python@v5
        if: steps.existe.outputs.pular == 'nao'
        with:
          python-version: "3.12"

      - name: Instalar bibliotecas
        if: steps.existe.outputs.pular == 'nao'
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt pyinstaller

      - name: Gravar o endereço para as atualizações
        if: steps.existe.outputs.pular == 'nao'
        shell: pwsh
        run: Set-Content -Path fatiador/_repo.py -Value 'REPO = "${{ github.repository }}"'

      - name: Montar o programa
        if: steps.existe.outputs.pular == 'nao'
        run: >
          pyinstaller --noconfirm --windowed --name FatiadorResina
          --icon recursos/icone.ico --add-data "recursos;recursos"
          --collect-data trimesh --collect-data pyvista
          --collect-submodules pyvistaqt --hidden-import fatiador._repo
          --exclude-module cv2 --exclude-module pandas --exclude-module skimage
          --exclude-module imageio_ffmpeg --exclude-module PySide6.QtWebEngineCore --exclude-module PySide6.QtWebEngineWidgets
          --exclude-module PySide6.QtQuick --exclude-module PySide6.QtQml --exclude-module PySide6.Qt3DCore
          --exclude-module PySide6.QtMultimedia --exclude-module PySide6.QtPdf --exclude-module PySide6.QtCharts
          --exclude-module PySide6.QtDataVisualization --exclude-module tkinter --exclude-module IPython
          --exclude-module jupyter_client --exclude-module trame
          main.py

      - name: Montar o instalador
        if: steps.existe.outputs.pular == 'nao'
        shell: pwsh
        run: |
          choco install innosetup -y --no-progress
          & "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe" "/DMinhaVersao=${{ steps.versao.outputs.numero }}" instalador.iss

      - name: Publicar a versão
        if: steps.existe.outputs.pular == 'nao'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ steps.versao.outputs.numero }}
          name: Fatiador Resina ${{ steps.versao.outputs.numero }}
          body_path: NOVIDADES.md
          files: saida/*.exe
